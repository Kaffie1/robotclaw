<launch>
    <!-- what config we are going to run (should match folder name) -->
    <arg name="verbosity"   default="DEBUG" /> <!-- ALL, DEBUG, INFO, WARNING, ERROR, SILENT -->
    <arg name="config"      default="rx" /> <!-- euroc_mav, tum_vi, rpng_aruco -->
    <arg name="config_glue" default="$(find ov_msckf)/config/$(arg config)/superpoint_lightglue.yaml" />
    <arg name="config_path" default="$(find ov_msckf)/config/$(arg config)/estimator_config.yaml" />
    <arg name="config_reloc" default="$(find ov_msckf)/config/reloc.yaml" />
    <arg name="config_interface" default="$(find ov_msckf)/config/ros_interface.yaml" />

    <!-- mono or stereo and what ros bag to play -->
    <arg name="use_stereo"  default="false" />
    <arg name="bag_start"   default="1" /> <!-- v1-2: 0, mh1: 40, mh2: 35, mh3: 17.5, mh4-5: 15 -->
    <arg name="bag_rate"    default="4" />
    <arg name="dataset"     default="robot_large_loop_nb" /> <!-- robot_large_loop -->
    <arg name="dobag"       default="false" /> <!-- if we should play back the bag -->
    <arg name="bag"         default="/datasets/wolong/$(arg dataset).bag" />

    <!-- saving trajectory path and timing information -->
    <arg name="dosave"      default="false" />
    <arg name="dotime"      default="true" />
    <arg name="path_est"    default="/var/log/traj_sp_lg.txt" />
    <arg name="path_time"   default="/vins_multi/results/no_calib/timing_sp_lg.txt" />

    <arg name="model_dir" default = "$(find ov_core)/output" />

    <!-- if we should viz the groundtruth -->
    <arg name="dolivetraj"  default="false" />
    <arg name="path_gt"     default="$(find ov_data)/$(arg config)/$(arg dataset).txt" />
    
    <!-- if we use compressed images & if we use shm -->
    <arg name="do_compress" default="false" />
    <arg name="use_shm"     default="false" />

    <!-- MASTER NODE! -->
   <!-- <node name="ov_msckf" pkg="ov_msckf" type="run_subscribe_msckf" output="screen" clear_params="true" required="true" launch-prefix="xterm -e gdb &#45;&#45;args"> -->
    <node name="ov_msckf" pkg="ov_msckf" type="run_subscribe_msckf" output="screen" clear_params="true" required="true">
        <param name="publish_global_to_imu_tf" type="bool" value="true"/>
        <param name="publish_calibration_tf" type="bool" value="false"/>
        <param name="use_compressed_images" type="bool" value="$(arg do_compress)"/>
        <param name="use_shm" type="bool" value="$(arg use_shm)"/>

        <param name="config_glue"            type="string" value="$(arg config_glue)" />
        <param name="model_dir"              type="string" value="$(arg model_dir)" />

        <!-- master configuration object -->
        <param name="verbosity"              type="string" value="$(arg verbosity)" />
        <param name="config_path"            type="string" value="$(arg config_path)" />
        <param name="config_interface"       type="string" value="$(arg config_interface)" />

        <!-- world/filter parameters -->
        <param name="use_stereo"             type="bool"   value="$(arg use_stereo)" />
        <param name="use_reloc"              type="bool"   value="true" />
        <param name="config_reloc"           type="string" value="$(arg config_reloc)" />

        <!-- timing statistics recording -->
        <param name="record_timing_information"   type="bool"   value="$(arg dotime)" />
        <param name="record_timing_filepath"      type="string" value="$(arg path_time)" />
    </node>

    <!-- <node type="rviz" name="rviz" pkg="rviz" args="-d $(find ov_msckf)/launch/display.rviz" /> -->

    <!-- play the dataset -->
    <group if="$(arg dobag)">
        <node pkg="rosbag" type="play" name="rosbag" args="-d 1 --pause -r $(arg bag_rate) -s $(arg bag_start) $(arg bag)" required="true"/>
    </group>

    <!-- record the trajectory if enabled -->
    <group if="$(arg dosave)">
        <node name="recorder_estimate" pkg="ov_eval" type="pose_to_file" output="screen" required="true">
            <param name="topic"      type="str" value="/ov_msckf/poseimu" />
            <param name="topic_type" type="str" value="PoseWithCovarianceStamped" />
            <param name="output"     type="str" value="$(arg path_est)" />
        </node>
    </group>

    <!-- path viz of aligned gt -->
    <group if="$(arg dolivetraj)">
        <node name="live_align_trajectory" pkg="ov_eval" type="live_align_trajectory" output="log" clear_params="true">
            <param name="alignment_type" type="str" value="posyaw" />
            <param name="path_gt"        type="str" value="$(arg path_gt)" />
        </node>
    </group>
</launch>
