[supervisord]
nodaemon=true  ; supervisor运行时不以守护进程模式运行，适合容器
user=root

{# ######################################################################## #}
{# ## 对于realsense_xxx程序，docker镜像启动时只会启动realsense_up            #}
{# ## 其他realsense要进入容器中手动启动和停止，其他realsense的autostart=false   #}
{# ## 启动某个程序：supervisorctl start realsense_xxx                       #}
{# ## 停止某个程序：supervisorctl stop realsense_xxx                        #}
{# ## 重启某个程序：supervisorctl restart realsense_xxx                     #}
{# ## docker compose exec sensor supervisorctl -c /etc/sensor/supervisor_sensor.conf start realsense_upper#}
{# ######################################################################## #}

{# 定义一个宏，用于生成单个Realsense的program配置 #}
{% macro realsense_program(name, config) -%}
{% set cmd_args = [] -%}
{% set internal_keys = ['autostart', 'launch_file'] -%}

{# 默认值 #}
{% set start_delay = 3 -%}
{% set priority_val = 50 -%}

{# 为特定的相机设置特定的顺序 #}
{# head: 第一个启动，无延时，优先级最高(数字越小优先级越高) #}
{% if 'head' in name -%}
    {% set start_delay = 0 -%}
    {% set priority_val = 10 -%}
{# up: 第二个启动，延时3秒 #}
{% elif 'up' in name -%}
    {% set start_delay = 3 -%}
    {% set priority_val = 20 -%}
{# down: 第三个启动，延时6秒 #}
{% elif 'down' in name -%}
    {% set start_delay = 6 -%}
    {% set priority_val = 30 -%}
{% endif -%}

{# 遍历config字典中的所有键值对 #}
{% for key, value in config.items() -%}
    {# 1. 过滤掉内部键和值为'default'的键 #}
    {% if key not in internal_keys and value != 'default' -%}
        {# 2. 键名映射 #}
        {% set ros_key = key -%}

        {# 3. 值处理 #}
        {% if value is sameas true -%}
            {% set ros_value = 'true' -%}
        {% elif value is sameas false -%}
            {% set ros_value = 'false' -%}
        {% else -%}
            {% set ros_value = value -%}
        {% endif -%}

        {# 4. 添加到参数列表 #}
        {% set _ = cmd_args.append(ros_key ~ ':=' ~ ros_value) -%}

    {% endif -%}
{% endfor %}

[program:realsense_{{ name }}]
{# 核心修改：使用 bash -c 实现延时，并用 exec 确保信号传递 #}
command=bash -c "echo 'Delayed start for {{ start_delay }}s...'; sleep {{ start_delay }}; rosparam set /zj_humanoid/sensor/realsense_{{ name }}/color/image_raw/compressed/jpeg_quality 30; exec roslaunch realsense2_camera {{ config.launch_file }} release_version:=25R3 {{ cmd_args | join(' ') }}"
autostart={{ config.autostart }}
autorestart=true
stdout_logfile=/var/log/rs_camera_{{ name }}.out.log
redirect_stderr=true
priority={{ priority_val }}
startsecs=5
stopasgroup=true
killasgroup=true
{% endmacro %}

{# 为 OAK 驱动构建命令行参数 #}
{% set oak_cmd_args = [] -%}
{# 遍历 oak 字典中的所有键值对 #}
{% for key, value in oak.items() -%}
    {% if key != 'autostart' -%}
        {# 将 Python 的布尔值 True/False 转换成 ROS 命令行的小写 true/false #}
        {% if value is sameas true -%}
            {% set _ = oak_cmd_args.append(key ~ ':=true') -%}
        {% elif value is sameas false -%}
            {% set _ = oak_cmd_args.append(key ~ ':=false') -%}
        {# 其他所有值（数字、字符串）直接拼接 #}
        {% else -%}
            {% set _ = oak_cmd_args.append(key ~ ':=' ~ value) -%}
        {% endif -%}
    {% endif -%}
{% endfor %}

[program:oak_script]
command=roslaunch oak_driver oak_driver_node.launch {{ oak_cmd_args | join(' ') }}
autostart={{ oak.autostart | default(true) }}
autorestart=true
stdout_logfile=/var/log/oak_ros_cam_imu.out.log
redirect_stderr=true
priority=3
startsecs=5
environment=OAK_FPS=16,OAK_IMU_FPS=200,OAK_EXPOSURE_MODE=3,OAK_EXPOSURE_TIME=3000,OAK_SENS_ISO=1000,OAK_SET_MANUAL_WB=false,OAK_WB_MANUAL=5000,OAK_MAX_EXPOSURE_TIME_US=3000,OAK_RELEASE_VERSION=25R3

{# 使用循环来动态生成所有Realsense相机的配置 #}
{% for name, config in realsense_cameras.items() %}
{{ realsense_program(name, config) }}
{% endfor %}

[program:wrist_camera]
command=/bin/bash -c "export PYTHONUNBUFFERED=1; rosrun wrist_camera camera2topic.py --width {{ wrist_camera.width }} --height {{ wrist_camera.height }} --compressed --quality {{ wrist_camera.compressed_quality }}"
autostart={{ wrist_camera.autostart | default(false) }}
autorestart=true
stdout_logfile=/var/log/wrist_camera.out.log
redirect_stderr=true
priority=3
startsecs=5

[program:sensor_restart_service]
command=bash -c "export PYTHONUNBUFFERED=1; rosrun sensor_control sensor_restart_service.py _config_path:='/etc/naviai/sensor_config.yml'"
autostart=true
autorestart=true
stdout_logfile=/var/log/sensor_restart_service.out.log
redirect_stderr=true
priority=10
startsecs=3

[program:sshd]
command=/usr/sbin/sshd -D -e
autostart=true
autorestart=true
stdout_logfile=/var/log/sshd.out.log
redirect_stderr=true
startsecs=1  ; 守护进程启动很快，可以设为1秒
; 当 supervisor 停止 sshd 时，确保其子进程也被正确关闭
stopasgroup=true
killasgroup=true

[unix_http_server]
file=/tmp/supervisor.sock
chmod=0700

[supervisorctl]
serverurl=unix:///tmp/supervisor.sock

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface