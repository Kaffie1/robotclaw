{# supervisor.conf.j2 #}
[supervisord]
nodaemon=true  ; supervisor运行时不以守护进程模式运行，适合容器
user=root

; =============================================================
;  This file is auto-generated by generate_config.py
;  Do not edit this file manually!
; =============================================================

{% for program in programs %}
[program:{{ program.name }}]
{# 如果程序定义了完整的 command，就用它；否则，根据 script 构建默认命令 #}
{% if program.command %}
command={{ program.command }}
{% else %}
command=/bin/bash -c "source /navi_ws/devel/setup.bash && python3 -u {{ program.script }}"
{% endif %}
autostart={{ program.get('autostart', true) }}
autorestart={{ program.get('autorestart', true) }}
stdout_logfile=/var/log/{{ loop.index }}_{{ program.name }}.log
redirect_stderr=true
startretries=3
priority={{ program.get('priority', 4) }}
startsecs={{ program.get('startsecs', 60) }}

{% endfor %}

[unix_http_server]
file=/tmp/supervisor.sock
chmod=0700

[supervisorctl]
serverurl=unix:///tmp/supervisor.sock

# supervisorctl -c /etc/manipulation/supervisor_manipulation.conf restart xxx
[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface