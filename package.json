{
	"name": "robotclaw",
	"version": "0.1.0",
	"private": true,
	"description": "Robot fault diagnosis and recovery assistant built on Pi",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi",
		"robotics",
		"rag",
		"ros",
		"agent"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kaffie1/robotclaw.git"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"dev": "concurrently -k -n server,web,knowledge -c blue,green,magenta \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:knowledge\"",
		"dev:server": "cross-env PI_WEB_PORT=8788 PI_WEB_MANAGED=1 PI_WEB_TABS=chat,search,settings PI_WEB_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 node --watch --import tsx apps/gateway/src/index.ts",
		"dev:web": "vite --config apps/web/vite.config.ts",
		"dev:knowledge": "node scripts/run-knowledge.mjs",
		"build": "npm run build:web && npm run build:server && npm run build:dsh-runtime",
		"build:web": "vite build --config apps/web/vite.config.ts",
		"build:server": "tsc -p apps/gateway/tsconfig.json",
		"build:dsh-runtime": "node scripts/copy-dsh-runtime.mjs",
		"typecheck": "tsc -p apps/gateway/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
		"test": "npm run test:unit && npm run test:knowledge",
		"test:unit": "vitest run",
		"test:knowledge": "cross-env PYTHONPATH=services/knowledge/src python3 -m unittest discover -s services/knowledge/tests -p 'test_*.py'",
		"knowledge:preview": "node scripts/knowledge.mjs preview",
		"knowledge:rebuild": "node scripts/knowledge.mjs rebuild",
		"check:protocol": "node scripts/check-protocol-sync.mjs",
		"start": "concurrently -k -n gateway,knowledge -c blue,magenta \"npm:start:gateway\" \"npm:start:knowledge\"",
		"start:gateway": "cross-env PI_WEB_MANAGED=1 PI_WEB_TABS=chat,search,settings node --import ./dist/gateway/resolve-global-sdk.js dist/gateway/index.js",
		"start:knowledge": "node scripts/run-knowledge.mjs",
		"format": "prettier --write apps/gateway/src/ apps/web/src/ scripts/ tests/unit/",
		"format:check": "prettier --check apps/gateway/src/ apps/web/src/ scripts/ tests/unit/",
		"lint": "oxlint apps/gateway/src/ apps/web/src/",
		"lint:fix": "oxlint --fix apps/gateway/src/ apps/web/src/"
	},
	"dependencies": {
		"@deepseek-ai/dsh-sdk-jsonrpc-server": "^0.1.5-rc.3",
		"@deepseek-ai/dsh-sdk-protocol": "^0.1.5-rc.3",
		"@earendil-works/pi-agent-core": "^0.87.1",
		"@earendil-works/pi-ai": "^0.87.1",
		"@earendil-works/pi-coding-agent": ">=0.85.1",
		"compression": "^1.8.2",
		"express": "^5.2.1",
		"node-pty": "^1.1.0",
		"tar": "^7.5.22",
		"typebox": "^1.3.34",
		"undici": "^8.9.0",
		"ws": "^8.21.3",
		"yauzl": "^3.4.0"
	},
	"devDependencies": {
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/ws": "^8.18.1",
		"@types/yauzl": "^3.4.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"highlight.js": "^11.12.0",
		"html-to-image": "^1.11.13",
		"jsdom": "^30.1.0",
		"katex": "^0.18.7",
		"oxlint": "^1.83.0",
		"playwright-core": "^1.63.0",
		"prettier": "^3.9.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"allowScripts": {
		"node-pty@1.1.0": true
	}
}
