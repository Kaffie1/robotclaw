{
  "compose_project_root": "/home/naviai/navi_project",
  "compose_service_name": "rosbridge",
  "commands": {
    "cat_file": "cat {path}",
    "topic_list": "rostopic list",
    "service_list": "rosservice list",
    "topic_info": "rostopic info {name}",
    "topic_type": "rostopic type {name}",
    "message_definition": "rosmsg show {type_name}",
    "topic_echo_once": "timeout 5s rostopic echo -n 1 {name}",
    "topic_publish": "rostopic pub -1 {name} {message_type}",
    "service_info": "rosservice info {name}",
    "service_type": "rosservice type {name}",
    "service_definition": "rossrv show {type_name}",
    "service_call": "rosservice call {name}"
  }
}
